<Project Sdk="Microsoft.NET.Sdk" InitialTargets="ConfigureNative">
    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <LangVersion>latest</LangVersion>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <DebugType>none</DebugType>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <GenerateDependencyFile>False</GenerateDependencyFile>
    </PropertyGroup>

    <Import Project="../Raylib-cs-custom/Build.props" />

    <PropertyGroup>
        <WgpuNativeVersion Condition="'$(WgpuNativeVersion)' == ''">29.0.0.0</WgpuNativeVersion>
        <WgpuNativeTag Condition="'$(WgpuNativeTag)' == ''">v$(WgpuNativeVersion)</WgpuNativeTag>
        <WgpuNativeReleaseBaseUrl>https://github.com/gfx-rs/wgpu-native/releases/download/$(WgpuNativeTag)</WgpuNativeReleaseBaseUrl>
        <Sdl3Version Condition="'$(Sdl3Version)' == ''">3.2.22</Sdl3Version>
        <RaylibSourceDir>$(MSBuildProjectDirectory)/$(BaseIntermediateOutputPath)raylib-gpu-$(TargetRaylibTag)</RaylibSourceDir>
        <NativeRuntimeDir>$(MSBuildProjectDirectory)/bin/$(Configuration)/native/raylib/</NativeRuntimeDir>
        <NativeFilePrefix>lib</NativeFilePrefix>
    </PropertyGroup>

    <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
        <NativeExt>so</NativeExt>
        <NativePre>lib</NativePre>
        <NativeArch Condition="'$(BuildArch)' == ''">x64</NativeArch>
        <NativeArch Condition="'$(BuildArch)' != ''">$(BuildArch)</NativeArch>
        <NativeRid>linux-$(NativeArch)</NativeRid>
        <WgpuPlatform>linux</WgpuPlatform>
        <WgpuLibraryName>libwgpu_native.so</WgpuLibraryName>
        <WgpuRuntimeName>libwgpu_native.so</WgpuRuntimeName>
    </PropertyGroup>

    <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
        <NativeExt>dylib</NativeExt>
        <NativePre>lib</NativePre>
        <NativeArch Condition="'$(BuildArch)' == ''">x86_64</NativeArch>
        <NativeArch Condition="'$(BuildArch)' != ''">$(BuildArch)</NativeArch>
        <NativeRid Condition="'$(NativeArch)' == 'x86_64'">osx-x64</NativeRid>
        <NativeRid Condition="'$(NativeArch)' == 'arm64'">osx-arm64</NativeRid>
        <WgpuPlatform>macos</WgpuPlatform>
        <WgpuLibraryName>libwgpu_native.dylib</WgpuLibraryName>
        <WgpuRuntimeName>libwgpu_native.dylib</WgpuRuntimeName>
    </PropertyGroup>

    <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
        <NativeExt>dll</NativeExt>
        <NativePre>$(Configuration)/</NativePre>
        <NativeRuntimeDir>$(MSBuildProjectDirectory)/bin/$(Configuration)/native/raylib/$(Configuration)/</NativeRuntimeDir>
        <NativeFilePrefix></NativeFilePrefix>
        <NativeArch Condition="'$(BuildArch)' == ''">x64</NativeArch>
        <NativeArch Condition="'$(BuildArch)' != ''">$(BuildArch)</NativeArch>
        <NativeRid Condition="'$(NativeArch)' == 'win32'">win-x86</NativeRid>
        <NativeRid Condition="'$(NativeArch)' == 'x64'">win-x64</NativeRid>
        <NativeRid Condition="'$(NativeArch)' == 'arm64'">win-arm64</NativeRid>
        <WgpuPlatform>windows</WgpuPlatform>
        <WgpuLibraryName>wgpu_native.dll.lib</WgpuLibraryName>
        <WgpuRuntimeName>wgpu_native.dll</WgpuRuntimeName>
    </PropertyGroup>

    <PropertyGroup Condition="'$(BuildPlatform)' == 'Android'">
        <NativeExt>so</NativeExt>
        <NativePre>lib</NativePre>
        <AndroidNdk Condition="'$(AndroidNdk)' == ''">$(ANDROID_NDK)</AndroidNdk>
        <AndroidNdk Condition="'$(AndroidNdk)' == ''">$(ANDROID_NDK_HOME)</AndroidNdk>
        <AndroidNdk Condition="'$(AndroidNdk)' == ''">$(ANDROID_NDK_ROOT)</AndroidNdk>
    </PropertyGroup>

    <PropertyGroup Condition="'$(BuildPlatform)' == 'Android' AND '$(BuildArch)' == 'arm'">
        <NativeArch>armeabi-v7a</NativeArch>
        <NativeRid>android-arm</NativeRid>
    </PropertyGroup>

    <PropertyGroup Condition="'$(BuildPlatform)' == 'Android' AND '$(BuildArch)' == 'arm64'">
        <NativeArch>arm64-v8a</NativeArch>
        <NativeRid>android-arm64</NativeRid>
    </PropertyGroup>

    <PropertyGroup Condition="'$(BuildPlatform)' == 'Android' AND '$(BuildArch)' == 'x86'">
        <NativeArch>x86</NativeArch>
        <NativeRid>android-x86</NativeRid>
    </PropertyGroup>

    <PropertyGroup Condition="'$(BuildPlatform)' == 'Android' AND '$(BuildArch)' == 'x64'">
        <NativeArch>x86_64</NativeArch>
        <NativeRid>android-x64</NativeRid>
    </PropertyGroup>

    <PropertyGroup Condition="'$(WgpuPlatform)' == 'windows' AND '$(NativeArch)' == 'win32'">
        <WgpuArch>i686</WgpuArch>
        <Sdl3LibArch>x86</Sdl3LibArch>
    </PropertyGroup>

    <PropertyGroup Condition="'$(WgpuPlatform)' == 'windows' AND '$(NativeArch)' == 'x64'">
        <WgpuArch>x86_64</WgpuArch>
        <Sdl3LibArch>x64</Sdl3LibArch>
    </PropertyGroup>

    <PropertyGroup Condition="'$(WgpuPlatform)' == 'windows' AND '$(NativeArch)' == 'arm64'">
        <WgpuArch>aarch64</WgpuArch>
        <Sdl3LibArch>arm64</Sdl3LibArch>
    </PropertyGroup>

    <PropertyGroup Condition="'$(WgpuPlatform)' == 'linux' AND '$(NativeArch)' == 'x64'">
        <WgpuArch>x86_64</WgpuArch>
    </PropertyGroup>

    <PropertyGroup Condition="'$(WgpuPlatform)' == 'linux' AND '$(NativeArch)' == 'arm64'">
        <WgpuArch>aarch64</WgpuArch>
    </PropertyGroup>

    <PropertyGroup Condition="'$(WgpuPlatform)' == 'macos' AND '$(NativeArch)' == 'x86_64'">
        <WgpuArch>x86_64</WgpuArch>
    </PropertyGroup>

    <PropertyGroup Condition="'$(WgpuPlatform)' == 'macos' AND '$(NativeArch)' == 'arm64'">
        <WgpuArch>aarch64</WgpuArch>
    </PropertyGroup>

    <PropertyGroup Condition="'$(BuildPlatform)' == '' AND '$(WgpuPlatform)' != ''">
        <UsesDesktopWgpu>true</UsesDesktopWgpu>
        <WgpuRoot>$(MSBuildProjectDirectory)/$(BaseIntermediateOutputPath)wgpu-native-$(WgpuPlatform)-$(NativeArch)</WgpuRoot>
        <WgpuArchiveName>wgpu-$(WgpuPlatform)-$(WgpuArch)-release.zip</WgpuArchiveName>
        <WgpuArchiveName Condition="'$(WgpuPlatform)' == 'windows'">wgpu-windows-$(WgpuArch)-msvc-release.zip</WgpuArchiveName>
        <WgpuNativeLibrary>$(WgpuRoot)/lib/$(WgpuLibraryName)</WgpuNativeLibrary>
        <WgpuRuntimeFile>$(WgpuRoot)/lib/$(WgpuRuntimeName)</WgpuRuntimeFile>
        <Sdl3UnzipDir>$(MSBuildProjectDirectory)/$(BaseIntermediateOutputPath)sdl3-$(Sdl3Version)-$(NativeArch)</Sdl3UnzipDir>
        <Sdl3SourceDir>$(MSBuildProjectDirectory)/$(BaseIntermediateOutputPath)SDL3-$(Sdl3Version)</Sdl3SourceDir>
        <Sdl3BuildDir>$(MSBuildProjectDirectory)/$(BaseIntermediateOutputPath)sdl3-build-$(NativeArch)</Sdl3BuildDir>
        <Sdl3InstallDir>$(MSBuildProjectDirectory)/$(BaseIntermediateOutputPath)sdl3-install-$(NativeArch)</Sdl3InstallDir>
        <Sdl3CmakeDir>$(Sdl3InstallDir)/lib/cmake/SDL3</Sdl3CmakeDir>
    </PropertyGroup>

    <PropertyGroup>
        <NativeBuildDir>$(MSBuildProjectDirectory)/$(BaseIntermediateOutputPath)native-build-$(NativeRid)</NativeBuildDir>
        <NativeRaylibBuildFile>$(NativeBuildDir)/raylib/$(NativePre)raylib.$(NativeExt)</NativeRaylibBuildFile>
        <NativeRaylibRuntimeFile>$(NativeRuntimeDir)$(NativeFilePrefix)raylib.$(NativeExt)</NativeRaylibRuntimeFile>
    </PropertyGroup>

    <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
        <CMakeArgs Include="-DCMAKE_OSX_ARCHITECTURES=$(NativeArch)" />
        <CMakeArgs Include="-DSUPPORT_FILEFORMAT_JPG=ON" />
    </ItemGroup>

    <ItemGroup Condition="$([MSBuild]::IsOsPlatform('Windows')) AND $(NativeArch) == 'win32'">
        <CMakeArgs Include="-A win32" />
    </ItemGroup>

    <ItemGroup Condition="$([MSBuild]::IsOsPlatform('Windows')) AND $(NativeArch) == 'x64'">
        <CMakeArgs Include="-A x64" />
    </ItemGroup>

    <ItemGroup Condition="$([MSBuild]::IsOsPlatform('Windows')) AND $(NativeArch) == 'arm64'">
        <CMakeArgs Include="-A ARM64" />
    </ItemGroup>

    <ItemGroup Condition="'$(UsesDesktopWgpu)' == 'true'">
        <CMakeArgs Include="-D PLATFORM=SDL" />
        <CMakeArgs Include="-D GRAPHICS_API=WGPU" />
        <CMakeArgs Include="-D WGPU_NATIVE_INCLUDE_DIR=$(WgpuRoot)/include" />
        <CMakeArgs Include="-D WGPU_NATIVE_LIBRARY=$(WgpuNativeLibrary)" />
    </ItemGroup>

    <ItemGroup Condition="'$(BuildPlatform)' == 'Android'">
        <CMakeArgs Include="-D CMAKE_TOOLCHAIN_FILE=$(AndroidNdk)/build/cmake/android.toolchain.cmake" />
        <CMakeArgs Include="-D PLATFORM=Android" />
        <CMakeArgs Include="-D ANDROID_ABI=$(NativeArch)" />
        <CMakeArgs Include="-D ANDROID_PLATFORM=21" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="$(NativeRaylibRuntimeFile)"
                 Link="%(Filename)%(Extension)"
                 CopyToOutputDirectory="PreserveNewest"
                 Condition="Exists('$(NativeRaylibRuntimeFile)')" />

        <Content Include="$(NativeRuntimeDir)*SDL3*"
                 Link="%(Filename)%(Extension)"
                 CopyToOutputDirectory="PreserveNewest"
                 Condition="'$(UsesDesktopWgpu)' == 'true'" />

        <Content Include="$(NativeRuntimeDir)*wgpu_native*"
                 Link="%(Filename)%(Extension)"
                 CopyToOutputDirectory="PreserveNewest"
                 Condition="'$(UsesDesktopWgpu)' == 'true'" />

        <CMakeArgs Include="-B $(NativeBuildDir)" />
        <CMakeArgs Include="-S $(RaylibSourceDir)" />
        <CMakeArgs Include="-D CMAKE_BUILD_TYPE=$(Configuration)" />
        <CMakeArgs Include="-D BUILD_SHARED_LIBS=ON" />
        <CMakeArgs Include="-D BUILD_EXAMPLES=OFF" />
        <CMakeArgs Include="-D CMAKE_MSVC_RUNTIME_LIBRARY=MultiThreaded" />
        <CMakeArgs Include="-D CMAKE_MINIMUM_REQUIRED_VERSION=3.15" />
        <CMakeArgs Include="-D CMAKE_POLICY_DEFAULT_CMP0091=NEW" />
        <!-- <CMakeArgs Include="-D GLFW_BUILD_WAYLAND=ON" /> -->
        <!-- <CMakeArgs Include="-D GRAPHICS=GRAPHICS_API_OPENGL_43" /> -->
    </ItemGroup>

    <Target Name="ConfigureNative" Condition="$(SkipLocalBuild) != true">
        <!-- Fetch raylib source from the private Capo-Games/raylib-gpu repo via authenticated git clone.
             DownloadFile cannot auth private archives (HttpClient ignores URL userinfo), so we clone instead. -->
        <PropertyGroup>
            <RaylibRepoUrl Condition="'$(RAYLIB_TOKEN_SECRET)' != ''">https://x-access-token:$(RAYLIB_TOKEN_SECRET)@github.com/Capo-Games/raylib-gpu.git</RaylibRepoUrl>
            <RaylibRepoUrl Condition="'$(RAYLIB_TOKEN_SECRET)' == ''">https://github.com/Capo-Games/raylib-gpu.git</RaylibRepoUrl>
        </PropertyGroup>

        <RemoveDir Directories="$(RaylibSourceDir)" Condition="Exists('$(RaylibSourceDir)') And !Exists('$(RaylibSourceDir)/CMakeLists.txt')" />
        <Exec Command="git clone --depth 1 --branch $(TargetRaylibTag) $(RaylibRepoUrl) &quot;$(RaylibSourceDir)&quot;"
              Condition="!Exists('$(RaylibSourceDir)/CMakeLists.txt')" />
        <Error Text="raylib source directory was not cloned: $(RaylibSourceDir)" Condition="!Exists('$(RaylibSourceDir)/CMakeLists.txt')" />

        <Copy SourceFiles="$(MSBuildProjectDirectory)/android_main.c" DestinationFolder="$(RaylibSourceDir)/src" Condition="'$(BuildPlatform)' == 'Android'" />

        <DownloadFile SourceUrl="$(WgpuNativeReleaseBaseUrl)/$(WgpuArchiveName)"
                      DestinationFolder="$(BaseIntermediateOutputPath)"
                      DestinationFileName="$(WgpuArchiveName)"
                      Condition="'$(UsesDesktopWgpu)' == 'true' And !Exists('$(BaseIntermediateOutputPath)$(WgpuArchiveName)')" />

        <Unzip SourceFiles="$(BaseIntermediateOutputPath)$(WgpuArchiveName)"
               DestinationFolder="$(WgpuRoot)"
               OverwriteReadOnlyFiles="true"
               Condition="'$(UsesDesktopWgpu)' == 'true' And !Exists('$(WgpuNativeLibrary)')" />

        <DownloadFile SourceUrl="https://github.com/libsdl-org/SDL/releases/download/release-$(Sdl3Version)/SDL3-devel-$(Sdl3Version)-VC.zip"
                      DestinationFolder="$(BaseIntermediateOutputPath)"
                      DestinationFileName="sdl3-$(Sdl3Version)-VC.zip"
                      Condition="'$(UsesDesktopWgpu)' == 'true' And $([MSBuild]::IsOSPlatform('Windows')) And !Exists('$(BaseIntermediateOutputPath)sdl3-$(Sdl3Version)-VC.zip')" />

        <Unzip SourceFiles="$(BaseIntermediateOutputPath)sdl3-$(Sdl3Version)-VC.zip"
               DestinationFolder="$(Sdl3UnzipDir)"
               OverwriteReadOnlyFiles="true"
               Condition="'$(UsesDesktopWgpu)' == 'true' And $([MSBuild]::IsOSPlatform('Windows')) And !Exists('$(Sdl3UnzipDir)')" />

        <ItemGroup Condition="'$(UsesDesktopWgpu)' == 'true' And $([MSBuild]::IsOSPlatform('Windows'))">
            <Sdl3ConfigFile Include="$(Sdl3UnzipDir)/**/SDL3Config.cmake;$(Sdl3UnzipDir)/**/sdl3-config.cmake" />
            <Sdl3Dll Include="$(Sdl3UnzipDir)/**/lib/$(Sdl3LibArch)/SDL3.dll" />
        </ItemGroup>

        <PropertyGroup Condition="'$(UsesDesktopWgpu)' == 'true' And $([MSBuild]::IsOSPlatform('Windows'))">
            <Sdl3CmakeDir>@(Sdl3ConfigFile->'%(RootDir)%(Directory)'->Distinct())</Sdl3CmakeDir>
        </PropertyGroup>

        <DownloadFile SourceUrl="https://github.com/libsdl-org/SDL/releases/download/release-$(Sdl3Version)/SDL3-$(Sdl3Version).tar.gz"
                      DestinationFolder="$(BaseIntermediateOutputPath)"
                      DestinationFileName="SDL3-$(Sdl3Version).tar.gz"
                      Condition="'$(UsesDesktopWgpu)' == 'true' And !$([MSBuild]::IsOSPlatform('Windows')) And !Exists('$(BaseIntermediateOutputPath)SDL3-$(Sdl3Version).tar.gz')" />

        <Exec Command="tar -xzf &quot;$(BaseIntermediateOutputPath)SDL3-$(Sdl3Version).tar.gz&quot; -C &quot;$(BaseIntermediateOutputPath)&quot;"
              Condition="'$(UsesDesktopWgpu)' == 'true' And !$([MSBuild]::IsOSPlatform('Windows')) And !Exists('$(Sdl3SourceDir)/CMakeLists.txt')" />

        <Exec Command="cmake -S &quot;$(Sdl3SourceDir)&quot; -B &quot;$(Sdl3BuildDir)&quot; -D CMAKE_BUILD_TYPE=$(Configuration) -D CMAKE_INSTALL_PREFIX=&quot;$(Sdl3InstallDir)&quot; -D CMAKE_INSTALL_LIBDIR=lib -D SDL_SHARED=ON -D SDL_STATIC=OFF -D SDL_TESTS=OFF -D SDL_EXAMPLES=OFF"
              Condition="'$(UsesDesktopWgpu)' == 'true' And !$([MSBuild]::IsOSPlatform('Windows')) And !$([MSBuild]::IsOSPlatform('OSX')) And !Exists('$(Sdl3CmakeDir)')" />

        <Exec Command="cmake -S &quot;$(Sdl3SourceDir)&quot; -B &quot;$(Sdl3BuildDir)&quot; -D CMAKE_BUILD_TYPE=$(Configuration) -D CMAKE_INSTALL_PREFIX=&quot;$(Sdl3InstallDir)&quot; -D CMAKE_INSTALL_LIBDIR=lib -D CMAKE_OSX_ARCHITECTURES=$(NativeArch) -D SDL_SHARED=ON -D SDL_STATIC=OFF -D SDL_TESTS=OFF -D SDL_EXAMPLES=OFF"
              Condition="'$(UsesDesktopWgpu)' == 'true' And $([MSBuild]::IsOSPlatform('OSX')) And !Exists('$(Sdl3CmakeDir)')" />

        <Exec Command="cmake --build &quot;$(Sdl3BuildDir)&quot; --config $(Configuration) --target install"
              Condition="'$(UsesDesktopWgpu)' == 'true' And !$([MSBuild]::IsOSPlatform('Windows')) And !Exists('$(Sdl3CmakeDir)')" />

        <ItemGroup Condition="'$(UsesDesktopWgpu)' == 'true'">
            <CMakeArgs Include="-D SDL3_DIR=$(Sdl3CmakeDir)" />
        </ItemGroup>

        <PropertyGroup Condition="'$(BuildPlatform)' == 'Android'">
            <RaylibCMakeListsFile>$(RaylibSourceDir)/src/CMakeLists.txt</RaylibCMakeListsFile>
        </PropertyGroup>

        <ReadLinesFromFile Condition="'$(BuildPlatform)' == 'Android'" File="$(RaylibCMakeListsFile)">
            <Output TaskParameter="Lines" ItemName="CMakeListsFile" />
        </ReadLinesFromFile>

        <ItemGroup Condition="'$(BuildPlatform)' == 'Android'">
            <UpdatedCMakeLists Include="@(CMakeListsFile-&gt;Replace(`set(raylib_sources`, `set(raylib_sources android_main.c`)-&gt;Replace(`set_target_properties(raylib PROPERTIES`, `target_link_options(raylib PRIVATE &quot;-Wl,-z,max-page-size=16384&quot;)%0Aset_target_properties(raylib PROPERTIES`))" />
        </ItemGroup>

        <WriteLinesToFile File="$(RaylibCMakeListsFile)" Lines="@(UpdatedCMakeLists)" Overwrite="true" Condition="'$(BuildPlatform)' == 'Android'" />


        <Exec Command="cmake @(CMakeArgs, ' ') $(CMakeExtraArgs)" />
        <Exec Command="cmake --build $(NativeBuildDir) --config $(Configuration)" />

        <Copy SourceFiles="$(NativeRaylibBuildFile)"
              DestinationFolder="$(NativeRuntimeDir)"
              SkipUnchangedFiles="true"
              Condition="Exists('$(NativeRaylibBuildFile)')" />

        <ItemGroup Condition="'$(UsesDesktopWgpu)' == 'true'">
            <NativeRuntimeDependency Include="$(WgpuRuntimeFile)" Condition="Exists('$(WgpuRuntimeFile)')" />
        </ItemGroup>

        <ItemGroup Condition="'$(UsesDesktopWgpu)' == 'true' And $([MSBuild]::IsOSPlatform('Windows'))">
            <NativeRuntimeDependency Include="@(Sdl3Dll)" />
        </ItemGroup>

        <ItemGroup Condition="'$(UsesDesktopWgpu)' == 'true' And $([MSBuild]::IsOSPlatform('Linux'))">
            <NativeRuntimeDependency Include="$(Sdl3InstallDir)/lib/libSDL3.so*" />
        </ItemGroup>

        <ItemGroup Condition="'$(UsesDesktopWgpu)' == 'true' And $([MSBuild]::IsOSPlatform('OSX'))">
            <NativeRuntimeDependency Include="$(Sdl3InstallDir)/lib/libSDL3*.dylib" />
        </ItemGroup>

        <Copy SourceFiles="@(NativeRuntimeDependency)"
              DestinationFolder="$(NativeRuntimeDir)"
              SkipUnchangedFiles="true"
              Condition="'$(UsesDesktopWgpu)' == 'true' And '@(NativeRuntimeDependency)' != ''" />
    </Target>
</Project>
